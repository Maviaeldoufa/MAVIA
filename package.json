{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fix-imports": "node -e \"const fs=require('fs');const path=require('path');function walk(dir){fs.readdirSync(dir).forEach(f=>{const p=path.join(dir,f);if(fs.statSync(p).isDirectory())walk(p);else if(p.endsWith('.ts')||p.endsWith('.js')){let c=fs.readFileSync(p,'utf8');c=c.replace(/from '(\.[^']+)(?<!\.js)'/g,\"from '$1.js'\").replace(/from \"(\.[^\"]+)(?<!\.js)\"/g,'from \"$1.js\"');fs.writeFileSync(p,c,'utf8');}});}walk('./server');console.log('Imports fixed successfully!');\"",
    "build": "npm run fix-imports && tsc && vite build",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test tests/audit.test.ts tests/supabase-migration.test.ts tests/email-disabled.test.ts tests/vercel-and-sessions.test.ts",
    "db:migrate:dry": "tsx scripts/migrate-json-to-supabase.ts --dry-run",
    "db:migrate": "tsx scripts/migrate-json-to-supabase.ts --execute",
    "db:verify": "tsx scripts/migrate-json-to-supabase.ts --verify-only"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
